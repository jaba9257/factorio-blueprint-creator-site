/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/game-data/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/game-data/manifest.json
  Cache-Control: no-cache
/graphics/index.json
  Cache-Control: no-cache
/graphics/*
  X-Content-Type-Options: nosniff
